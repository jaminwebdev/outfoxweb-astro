---
interface Props {
  class?: string;
  reveal?: boolean;
}
const { class: className = '', reveal = false } = Astro.props;

type Mark =
  | { kind: 'pill'; d: string; color: string }
  | { kind: 'dot'; cx: number; cy: number; color: string };

// Separate segments let each pill enter independently, in a sweep through the rows.
const marks: Mark[] = [
  { kind: 'pill', d: 'M102 83h126', color: '--green' },
  { kind: 'dot', cx: 257, cy: 83, color: '--primary' },
  { kind: 'pill', d: 'M273 83h78', color: '--green' },
  { kind: 'pill', d: 'M63 129h235', color: '--primary' },
  { kind: 'dot', cx: 322, cy: 129, color: '--tertiary' },
  { kind: 'pill', d: 'M340 129h70', color: '--primary' },
  { kind: 'pill', d: 'M124 175h167', color: '--tertiary' },
  { kind: 'pill', d: 'M325 175h88', color: '--green' },
  { kind: 'pill', d: 'M44 221h97', color: '--primary' },
  { kind: 'dot', cx: 163, cy: 221, color: '--secondary' },
  { kind: 'pill', d: 'M183 221h209', color: '--primary' },
  { kind: 'pill', d: 'M84 267h166', color: '--green' },
  { kind: 'pill', d: 'M287 267h111', color: '--secondary' },
  { kind: 'pill', d: 'M136 313h90', color: '--primary' },
  { kind: 'dot', cx: 247, cy: 313, color: '--green' },
  { kind: 'pill', d: 'M265 313h90', color: '--primary' },
  { kind: 'pill', d: 'M171 359h153', color: '--green' },
];
---

<svg
  class:list={[className, { group: reveal }]}
  data-pill-reveal={reveal || undefined}
  viewBox="0 0 520 420"
  fill="none"
  width="520"
  height="420"
  aria-hidden="true"
  focusable="false"
>
  <g stroke-linecap="round" stroke-width="25">
    {
      marks.map((mark, index) => (
        <g
          class:list={[
            reveal &&
              'motion-safe:group-data-[reveal-state=pending]:opacity-0 motion-safe:group-data-[reveal-state=visible]:animate-pill-enter',
          ]}
          style={reveal ? `--pill-delay: ${index * 60}ms` : undefined}
        >
          <g transform="rotate(-39 260 210)">
            {mark.kind === 'pill' ? (
              <path d={mark.d} stroke={`var(${mark.color})`} />
            ) : (
              <circle cx={mark.cx} cy={mark.cy} r="10" fill={`var(${mark.color})`} stroke="none" />
            )}
          </g>
        </g>
      ))
    }
  </g>
</svg>

<script>
  let pillObserver: IntersectionObserver | undefined;

  function revealPills() {
    const patterns = document.querySelectorAll<SVGSVGElement>(
      '[data-pill-reveal]:not([data-reveal-state])',
    );
    if (!patterns.length) return;

    // Keep the artwork visible without JavaScript, with reduced motion, or without an observer.
    if (
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      !('IntersectionObserver' in window)
    ) {
      patterns.forEach((pattern) => (pattern.dataset.revealState = 'visible'));
      return;
    }

    pillObserver ??= new IntersectionObserver(
      (entries, observer) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          (entry.target as SVGSVGElement).dataset.revealState = 'visible';
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.1 },
    );

    patterns.forEach((pattern) => {
      pattern.dataset.revealState = 'pending';
      pillObserver!.observe(pattern);
    });
  }

  revealPills();
  document.addEventListener('astro:page-load', revealPills);
  document.addEventListener('astro:before-swap', () => {
    pillObserver?.disconnect();
    pillObserver = undefined;
  });
</script>
