---
import { Image } from 'astro:assets';
import Interior from '@/images/Interior_Design_Cover.webp';
import Financial from '@/images/Financial_Cover.webp';
---

<section id="work" class="mx-auto max-w-295 py-18 lg:py-24" aria-labelledby="work-heading">
  <header class="mb-10 grid gap-5 lg:grid-cols-2 lg:items-end lg:gap-12">
    <div>
      <p class="text-xs font-semibold tracking-eyebrow text-accent-foreground uppercase">
        A closer look
      </p>
      <h2 id="work-heading" class="mt-5 max-w-145 text-section font-black text-balance">
        Good design makes the next step feel obvious.
      </h2>
    </div>
    <p class="max-w-125 text-body leading-copy text-muted-foreground">
      A website should help people find their bearings. These examples show the kind of clarity we
      can build toward.
    </p>
  </header>

  <div class="grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-10">
    <figure class="min-w-0 lg:col-span-7">
      <div
        class="relative isolate px-5 pt-10 pb-6 before:pointer-events-none before:absolute before:inset-0 before:-z-1 before:[border-radius:40%_35%_8%_10%_/_45%_40%_15%_12%] before:bg-mint-soft motion-safe:before:animate-work-blob sm:px-8 sm:pt-12 sm:pb-8"
      >
        <Image
          class="block h-auto w-full rounded-sm border border-ink"
          src={Interior}
          alt="Interior services design example with a clear headline, spacious layout, and prominent contact action"
          widths={[480, 700]}
          sizes="(min-width: 1308px) 608px, (min-width: 1024px) calc(58.333vw - 155.333px), (min-width: 640px) calc(100vw - 192px), calc(100vw - 88px)"
          loading="lazy"
        />
      </div>
      <figcaption class="mt-6">
        <p class="text-base text-muted-foreground">Design example / Interior services</p>
        <h3 class="mt-3 text-card-title-lg font-demi text-balance">
          Space to understand the offer.
        </h3>
        <p class="mt-3 max-w-145 text-lg leading-copy text-muted-foreground">
          A calm hierarchy gives the service, supporting detail, and contact action room to be
          understood.
        </p>
      </figcaption>
    </figure>

    <figure class="min-w-0 lg:col-span-5 lg:mt-16">
      <div
        class="relative isolate px-5 py-8 before:pointer-events-none before:absolute before:inset-0 before:-z-1 before:[border-radius:10%_12%_38%_30%_/_15%_15%_42%_40%] before:bg-primary motion-safe:before:animate-work-blob-offset sm:px-6 sm:py-10"
      >
        <Image
          class="block h-auto w-full rounded-sm border border-ink"
          src={Financial}
          alt="Financial services design example with a service introduction and visible get-started action"
          widths={[480, 700]}
          sizes="(min-width: 1308px) 420px, (min-width: 1024px) calc(41.667vw - 124.667px), (min-width: 640px) calc(100vw - 176px), calc(100vw - 88px)"
          loading="lazy"
        />
      </div>
      <figcaption class="mt-6">
        <p class="text-base text-muted-foreground">Design example / Financial services</p>
        <h3 class="mt-3 text-card-title-lg font-demi text-balance">
          A clear route to a conversation.
        </h3>
        <p class="mt-3 max-w-120 text-lg leading-copy text-muted-foreground">
          For a service business, useful information and a visible next step belong together.
        </p>
      </figcaption>
    </figure>
  </div>

  <p class="mt-10 border-t border-border pt-5 text-base text-muted-foreground">
    Design examples from the existing library
  </p>
</section>
