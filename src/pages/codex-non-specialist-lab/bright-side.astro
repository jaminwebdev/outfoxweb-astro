        </p><h2
          class="[font-family:var(--sans)] [font-size:clamp(30px,_3.3vw,_43px)] font-black tracking-[-0.055em] leading-[1.13] m-0 mt-[20px] max-w-[435px] text-balance"
          id="questions-heading"
        >
          A few things you may be wondering.
        </h2>
      </div>
      <div class="">
        {
          questions.map((item) => (
            <details class="[border-top:1px_solid_var(--rule)] last:[border-bottom:1px_solid_var(--rule)]">
              <>
                <summary class="items-center cursor-pointer flex text-[14px] font-medium gap-[20px] justify-between leading-[1.5] list-none min-h-[66px] py-[24px] [&::-webkit-details-marker]:hidden focus-visible:[box-shadow:0_0_0_3px_var(--paper)] focus-visible:[outline:2px_solid_var(--ink)] focus-visible:[outline-offset:5px] hover:text-[color:var(--accent)]">
                  {item.question}
                  <span
                    class="inline-block [flex:0_0_12px] h-[12px] relative w-[12px] [details[open]_&]:after:hidden after:bg-current after:content-[''] after:h-[12px] after:left-[5px] after:absolute after:w-[1px] before:bg-current before:content-[''] before:h-[1px] before:absolute before:top-[5px] before:w-[12px]"
                    aria-hidden="true"
                  />
                </summary>
                <p class="text-[color:var(--muted)] text-[14px] leading-[1.8] m-0 max-w-[560px] [padding:0_28px_24px_0]">
                  {item.answer}
                </p>
              </>
            </details>
          ))
        }
      </div>
    </section>
    <section
      id="contact"
      class="[--accent:var(--accent-on-light)] [--ink:var(--on-light)] [--muted:var(--muted-on-light)] [--paper:var(--green-pale)] bg-[var(--paper)] rounded-[16px] text-[color:var(--ink)] [color-scheme:light] isolate mb-[36px] mx-auto [padding:45px_24px] relative [width:min(100%_-_44px,_1180px)] min-[640px]:[width:min(100%_-_80px,_1180px)] min-[900px]:[padding:65px_45px] overflow-hidden"
      aria-labelledby="contact-heading"
    >
      <div
        class="rounded-[inherit] [inset:0] pointer-events-none absolute z-[-1]"
