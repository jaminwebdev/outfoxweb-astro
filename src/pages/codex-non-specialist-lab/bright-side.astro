          {
            process.map((step, index) => (
              <li class="[border-top:1px_solid_var(--rule)] pt-[24px]">
                <>
                  <span
                    class="text-[color:var(--accent)] inline-block text-[27px] [font-weight:650] leading-[1] mb-[22px]"
                    aria-hidden="true"
                  >
                    0{index + 1}
                  </span>
                  <div>
                    <>
                      <h3 class="text-[21px] [font-weight:650] tracking-[-0.035em] leading-[1.35] m-0 text-balance">
                        {step.title}
                      </h3>
                      <p class="text-[color:var(--muted)] text-[14px] leading-[1.8] m-0 mt-[14px]">
                        {step.body}
                      </p>
                    </>
                  </div>
                </>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
    <section
      id="questions"
      class="grid gap-[35px] mx-auto py-[72px] [width:min(100%_-_44px,_1180px)] min-[640px]:[width:min(100%_-_80px,_1180px)] min-[900px]:gap-[65px] min-[900px]:grid-cols-[minmax(0,_1fr)_minmax(0,_1.5fr)] min-[900px]:py-[95px]"
