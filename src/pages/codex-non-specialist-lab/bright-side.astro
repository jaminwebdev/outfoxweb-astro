---
import { Image } from 'astro:assets';
import Layout from '@/layouts/NonSpecialistLabLayout.astro';
import Brand from '@/components/non-specialist-lab/Brand.astro';
import CapsulePattern from '@/components/non-specialist-lab/CapsulePattern.astro';
import PlayMark from '@/components/non-specialist-lab/PlayMark.astro';
import BrightSideBenefitCard from '@/components/cards/BrightSideBenefitCard.svelte';
import BrightSideServicesTabs from '@/components/sections/BrightSideServicesTabs.svelte';
import BrightSideWebsiteScan from '@/components/sections/BrightSideWebsiteScan.svelte';
import BrightSideBlogBento from '@/components/sections/BrightSideBlogBento.astro';
import Devices from '@/images/homepage_hero_img.webp';
import Interior from '@/images/Interior_Design_Cover.webp';
import Financial from '@/images/Financial_Cover.webp';

const email = 'mailto:hello@outfoxweb.com?subject=Let%27s%20talk%20through%20my%20website';
const process = [
  {
    title: 'Understand.',
    body: 'We talk about your business, your current website, and where people get stuck. Start with the problem you want to solve.',
  },
  {
    title: 'Shape.',
    body: 'We agree on priorities, content, and a design direction. You see the thinking and have room to give feedback.',
  },
  {
    title: 'Build & review.',
    body: 'I build and check the site. We review it together, work through the details, and agree on what launch and handoff need.',
  },
];
const questions = [
  {
    question: 'Do I need a completely new website?',
    answer:
      "Not necessarily. We'll look at what you have and what is getting in the way. The useful next step could be a focused improvement or a more substantial rebuild.",
  },
  {
    question: 'How do you use AI in your work?',
    answer:
      'I use it for ideas and to speed up parts of design and development. I review the code and decisions myself. The responsibility for the finished work stays with me.',
  },
  {
    question: 'What will my project cost?',
    answer:
      'That depends on the work your website needs. We discuss the scope and agree on a proposal before the project begins.',
  },
  {
    question: 'What happens after the website is built?',
    answer:
      'We agree on the handoff, access, and any support needs as part of the project scope, so you understand how the website will be managed.',
  },
];
---

<Layout
  title="Bright Side — Outfox Web homepage study"
  description="A playful mint-led homepage with inset panels, foreground device cutouts, diagonal capsules, and organic image windows."
  page="bright-side"
>
  <nav
    class="border-b border-border bg-secondary-light text-caption tracking-wide"
    aria-label="Design study"
  >
    <div class="mx-auto flex min-h-9 max-w-315 items-center justify-between gap-3 px-6 sm:px-10">
      <a
        class="inline-flex min-h-9 items-center gap-2.5 text-inherit no-underline focus-visible:outline-2 focus-visible:outline-offset-5 focus-visible:outline-ink"
        href="/codex-non-specialist-lab"><span aria-hidden="true">←</span> Design lab</a
      >
      <span>07 / Bright Side <span class="hidden sm:inline">— homepage study</span></span>
    </div>
  </nav>
  <header
    class="mx-auto flex max-w-315 flex-wrap items-center justify-between gap-x-5 gap-y-3.5 px-6 py-6.5 sm:px-10 md:flex-nowrap lg:py-7.5"
  >
    <Brand href="/codex-non-specialist-lab/bright-side" />
    <nav
      class="order-3 flex w-full justify-between gap-6 border-b border-border md:order-none md:mr-5 md:ml-auto md:w-auto md:gap-7 md:border-0 xl:mr-12 xl:gap-9"
      aria-label="Main navigation"
    >
      <a
        class="inline-flex min-h-11 items-center text-label text-inherit no-underline hover:text-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-5 focus-visible:outline-ink"
        href="#work">Work</a
      ><a
        class="inline-flex min-h-11 items-center text-label text-inherit no-underline hover:text-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-5 focus-visible:outline-ink"
        href="#testimonials">Kind words</a
      ><a
        class="inline-flex min-h-11 items-center text-label text-inherit no-underline hover:text-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-5 focus-visible:outline-ink"
        href="#questions">Questions</a
      >
    </nav>
    <a
      class="inline-flex min-h-11 items-center gap-2.5 text-caption font-medium text-inherit underline decoration-1 underline-offset-5 focus-visible:outline-2 focus-visible:outline-offset-5 focus-visible:outline-ink sm:text-label"
      href={email}>Talk through your website <span aria-hidden="true">↗</span></a
    >
  </header>
  <main class="px-6 focus:outline-none sm:px-16" id="main" tabindex="-1">
    <section class="mx-auto max-w-295 pt-6 overflow-x-hidden" aria-labelledby="hero-heading">
      <div
        class="relative isolate grid gap-7.5 rounded-2xl bg-mint px-5 py-10 text-ink sm:px-8 sm:pt-10.5 sm:pb-7 lg:grid-cols-[minmax(0,1.12fr)_minmax(0,1fr)] lg:items-center lg:px-12.5 lg:py-17"
      >
        <div
          class="pointer-events-none absolute inset-0 -z-1 rounded-2xl lg:left-[55%]"
          aria-hidden="true"
        >
          <CapsulePattern
            reveal
            class="pointer-events-none absolute -right-[10%] bottom-0 block h-auto w-full max-w-155 sm:right-0 sm:max-w-132.5 lg:-right-[20%] lg:w-[138%] lg:max-w-none"
          />
        </div>
        <div class="relative z-1 min-w-0">
          <p
            class="text-xs leading-normal font-semibold tracking-eyebrow text-primary-strong uppercase"
          >
            Website strategy, design & development
          </p>
          <h1 class="mt-5.5 max-w-147.5 text-display font-black text-balance" id="hero-heading">
            A better website starts with <em class="block text-primary-strong not-italic"
              >better judgment.</em
            >
          </h1>
          <p class="mt-6 max-w-109 text-body leading-copy text-muted-on-light lg:text-base">
            Your business needs a website people can understand, trust, and act on. I help you
            decide what matters, then design and build it with care.
          </p>
          <div class="mt-6.5 flex flex-wrap items-center gap-x-5 gap-y-3">
            <a
              class="inline-flex min-h-13.5 items-center justify-between gap-5.5 rounded-md border border-primary bg-primary px-5 py-4 text-label leading-label font-medium text-ink no-underline hover:border-primary-hover hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-5 focus-visible:outline-ink"
              href={email}
              >Talk through your website <span class="text-xl font-normal" aria-hidden="true"
                >↗</span
              ></a
            >
            <a
              class="inline-flex min-h-11 items-center gap-5 text-label font-medium text-inherit underline decoration-1 underline-offset-5 focus-visible:outline-2 focus-visible:outline-offset-5 focus-visible:outline-ink"
              href="#work">See the design examples <span aria-hidden="true">↓</span></a
            >
          </div>
        </div>
        <figure
          class="relative z-2 w-full max-w-135.5 min-w-0 sm:max-w-120 lg:w-[calc(100%+1.25rem)] lg:max-w-135.5"
        >
          <div class="relative">
            <PlayMark
              kind="arrow"
              class="hidden lg:absolute lg:top-[10%] lg:-left-8 lg:block lg:size-13.5 lg:text-primary-strong"
            />
            <Image
              class="relative block h-auto w-full"
              src={Devices}
              alt="Design example presented across a laptop and phones, with transparent space around the devices"
              widths={[360, 541]}
              sizes="(min-width: 1308px) 516px, (min-width: 1024px) calc(47.2vw - 102px), (min-width: 672px) 480px, (min-width: 640px) calc(100vw - 192px), calc(100vw - 88px)"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </figure>
      </div>
    </section>
    <section
      id="benefits"
      aria-label="Website benefits"
      class="mx-auto mt-10 grid max-w-295 gap-6 lg:mt-12 lg:gap-16 xl:grid-cols-3"
    >
      <BrightSideBenefitCard
        lottiePath="/lottie/BarChart_primary.json"
        heading="Multiply your conversions"
        body="We use data‑driven UX research to turn underperforming sites into conversion powerhouses."
        initialPlay
        client:load
      />
      <BrightSideBenefitCard
        lottiePath="/lottie/Globe_primary.json"
        heading="Reach users faster"
        body="Keep visitors engaged with lightning-fast websites that load faster than 99.9% of competitors."
        delay={750}
        initialPlay
        client:load
      />
      <BrightSideBenefitCard
        lottiePath="/lottie/server_primary.json"
        heading="Uninterrupted Performance"
        body="With 0% downtime over the past 3 years, our sites stay live when opportunities strike."
        delay={1500}
        initialPlay
        client:load
      />
    </section>
    <section
      id="work"
      class="mx-auto max-w-295 py-18 lg:grid lg:grid-cols-[minmax(0,_0.8fr)_minmax(0,_1.7fr)] lg:items-start lg:gap-x-11.5 lg:py-24"
      aria-labelledby="work-heading"
    >
      <div class="mb-9 max-w-165">
        <p class="text-xs leading-normal font-semibold tracking-eyebrow text-primary uppercase">
          A closer look
        </p><h2 class="mt-5 text-section font-black text-balance" id="work-heading">
          Good design makes<br />the next step feel obvious.
        </h2>
        <p class="mt-5.5 max-w-116.5 text-body text-ink-muted">
          A website should help people find their bearings. These examples show the kind of clarity
          we can build toward.
        </p>
      </div>
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-6.5">
        <figure>
          <div
            class="relative isolate px-4 py-7.5 before:absolute before:inset-0 before:-z-1 before:[border-radius:40%_35%_8%_10%_/_45%_40%_15%_12%] before:bg-mint-soft motion-safe:before:animate-work-blob sm:px-5.5 sm:py-10 lg:px-4 lg:py-6.5"
          >
            <Image
              class="block h-auto w-full rounded-sm border border-ink"
              src={Interior}
              alt="Interior services design example with a clear headline, spacious layout, and prominent contact action"
              widths={[480, 700]}
              sizes="(min-width: 1308px) 343px, (min-width: 1024px) calc(34vw - 102px), (min-width: 640px) calc(100vw - 172px), calc(100vw - 78px)"
              loading="lazy"
            />
          </div>
          <figcaption>
            <p
              class="mt-6 text-caption leading-normal font-semibold tracking-eyebrow text-ink-muted uppercase"
            >
              Design example / Interior services
            </p><h3 class="mt-3 text-card-title-lg font-demi text-balance">
              Space to understand the offer.
            </h3>
            <p class="mt-3 max-w-110 text-sm text-ink-muted">
              A calm hierarchy gives the service, supporting detail, and contact action room to be
              understood.
            </p>
          </figcaption>
        </figure>
        <figure>
          <div
            class="relative isolate px-4 py-7.5 before:absolute before:inset-0 before:-z-1 before:[border-radius:10%_12%_38%_30%_/_15%_15%_42%_40%] before:bg-primary motion-safe:before:animate-work-blob-offset sm:px-5.5 sm:py-10 lg:px-4 lg:py-6.5"
          >
            <Image
              class="block h-auto w-full rounded-sm border border-ink"
              src={Financial}
              alt="Financial services design example with a service introduction and visible get-started action"
              widths={[480, 700]}
              sizes="(min-width: 1308px) 343px, (min-width: 1024px) calc(34vw - 102px), (min-width: 640px) calc(100vw - 172px), calc(100vw - 78px)"
              loading="lazy"
            />
          </div>
          <figcaption>
            <p
              class="mt-6 text-caption leading-normal font-semibold tracking-eyebrow text-ink-muted uppercase"
            >
              Design example / Financial services
            </p><h3 class="mt-3 text-card-title-lg font-demi text-balance">
              A clear route to a conversation.
            </h3>
            <p class="mt-3 max-w-110 text-sm text-ink-muted">
              For a service business, useful information and a visible next step belong together.
            </p>
          </figcaption>
        </figure>
      </div>
      <p class="mt-9 border-t border-border pt-5 text-caption text-ink-muted lg:col-span-full">
        Design examples from the existing library
      </p>
    </section>
    <section id="testimonials" class="py-11.5" aria-labelledby="testimonials-heading">
      <div
        class="mx-auto grid max-w-295 items-center gap-7 rounded-2xl bg-dark-green px-6 py-10 text-paper sm:px-10 sm:py-12 lg:grid-cols-[18.75rem_minmax(0,_1fr)] lg:gap-14 lg:px-15 lg:py-15"
      >
        <div
          class="relative isolate mx-auto grid aspect-square w-full max-w-65 place-items-center sm:max-w-75"
        >
          <CapsulePattern
            class="pointer-events-none absolute [inset:-8%_-12%_auto] -z-1 block h-auto w-[124%]"
          />
          <div
            class="aspect-square w-[84%] overflow-hidden [border-radius:42%_58%_35%_65%_/_58%_42%_58%_42%] border-6 border-primary bg-mint-soft"
          >
            <img
              class="block h-full w-full object-cover"
              src="/images/headshot_placeholder.png"
              alt="Placeholder portrait for the testimonial design"
              width="89"
              height="89"
              loading="lazy"
            />
          </div>
        </div>
        <div class="min-w-0">
          <p class="text-xs leading-normal font-semibold tracking-eyebrow text-primary uppercase">
            Kind words
          </p>
          <h2 class="mt-4.5 text-section font-black text-balance" id="testimonials-heading">
            A clearer website.<br /><em class="text-primary not-italic">A better experience.</em>
          </h2>
          <figure>
            <blockquote class="mt-6.5 max-w-162.5">
              <p
                class="text-card-title leading-normal font-medium tracking-tight text-balance sm:text-quote"
              >
                “We finally have a website that feels like us. The process was clear, and every
                decision made sense.”
              </p>
            </blockquote>
            <figcaption class="mt-6 flex flex-wrap items-center gap-x-4.5 gap-y-3">
              <div>
                <p class="text-sm font-semibold">Client name</p>
                <p class="mt-1 text-xs text-muted-on-dark">Business owner · Company name</p>
              </div>
              <span class="border-l border-muted-on-dark pl-4.5 text-caption text-muted-on-dark"
                >Sample quote & placeholder portrait</span
              >
            </figcaption>
          </figure>
        </div>
      </div>
    </section>
    <BrightSideServicesTabs client:load />
    <section
      id="process"
      class="bg-secondary-light sm:-mx-10 sm:px-10"
      aria-labelledby="process-heading"
    >
      <div class="mx-auto max-w-295 py-18 lg:py-24">
        <div>
          <p class="text-xs leading-normal font-semibold tracking-eyebrow text-ink-muted uppercase">
            Working together
          </p><h2
            class="mt-5 max-w-172.5 text-section font-black text-balance"
            id="process-heading"
          >
            You'll know what happens next.
          </h2>
        </div>
        <ol class="mt-9.5 grid gap-7.5 lg:grid-cols-3 lg:gap-9">
          {
            process.map((step, index) => (
              <li class="border-t border-border pt-6">
                <>
                  <span
                    class="mb-5.5 inline-block text-step leading-none font-demi text-primary"
                    aria-hidden="true"
                  >
                    0{index + 1}
                  </span>
                  <div>
                    <>
                      <h3 class="text-card-title font-demi text-balance">{step.title}</h3>
                      <p class="mt-3.5 text-sm leading-copy text-ink-muted">{step.body}</p>
                    </>
                  </div>
                </>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
    <BrightSideWebsiteScan client:load />
    <section
      id="questions"
      class="mx-auto grid max-w-295 gap-9 py-18 lg:grid-cols-[minmax(0,_1fr)_minmax(0,_1.5fr)] lg:gap-16.5 lg:py-24"
      aria-labelledby="questions-heading"
    >
      <div>
        <p class="text-xs leading-normal font-semibold tracking-eyebrow text-primary uppercase">
          Before we begin
        </p><h2 class="mt-5 max-w-109 text-section font-black text-balance" id="questions-heading">
          A few things you may be wondering.
        </h2>
      </div>
      <div>
        {
          questions.map((item) => (
            <details class="group border-t border-border last:border-b">
              <>
                <summary class="flex min-h-16.5 cursor-pointer list-none items-center justify-between gap-5 py-6 text-sm leading-normal font-medium hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-5 focus-visible:outline-ink [&::-webkit-details-marker]:hidden">
                  {item.question}
                  <svg
                    class="size-3 shrink-0"
                    viewBox="0 0 12 12"
                    fill="none"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M0 6h12" />
                    <path class="group-open:hidden" d="M6 0v12" />
                  </svg>
                </summary>
                <p class="max-w-140 pr-7 pb-6 text-sm leading-copy text-ink-muted">{item.answer}</p>
              </>
            </details>
          ))
        }
      </div>
    </section>
    <BrightSideBlogBento />
    <section
      id="contact"
      class="relative isolate mx-auto mb-9 max-w-295 overflow-hidden rounded-2xl bg-mint px-6 py-11.5 text-ink lg:px-11.5 lg:py-16.5"
      aria-labelledby="contact-heading"
    >
      <div class="pointer-events-none absolute inset-0 -z-1 rounded-2xl" aria-hidden="true">
        <CapsulePattern
          reveal
          class="pointer-events-none absolute -right-37.5 -bottom-10 block h-auto w-57.5 sm:-right-24 sm:-bottom-12.5 sm:w-70 lg:-right-22.5 lg:-bottom-14 lg:w-67.5"
        />
      </div>
      <div class="relative mx-auto max-w-185 text-center">
        <p
          class="text-xs leading-normal font-semibold tracking-eyebrow text-primary-strong uppercase"
        >
          Let's start with your business
        </p><h2 class="mt-5 text-contact font-black text-balance" id="contact-heading">
          Tell me what your<br /><em class="text-primary-strong not-italic">website needs to do.</em
          >
        </h2>
        <p class="mx-auto mt-6 max-w-116.5 text-body text-muted-on-light">
          Send your current website, if you have one, and a little about what you'd like to improve.
          We'll start there.
        </p>
        <div class="mt-7 flex justify-center">
          <a
            class="inline-flex min-h-13.5 items-center justify-between gap-5.5 rounded-md border border-primary bg-primary px-5 py-4 text-label leading-label font-medium text-ink no-underline hover:border-primary-hover hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-5 focus-visible:outline-ink"
            href={email}
            >Talk through your website <span class="text-xl font-normal" aria-hidden="true">↗</span
            ></a
          >
        </div>
      </div>
    </section>
  </main>
  <footer
    class="mx-auto flex max-w-315 flex-wrap items-center gap-x-11.5 gap-y-7 px-6 py-8.5 sm:px-10"
  >
    <Brand href="/codex-non-specialist-lab/bright-side" /><p class="text-caption text-ink-muted">
      Thoughtful websites. Independent expertise.<br />Carlsbad, California.
    </p>
    <nav class="flex flex-wrap gap-x-6.5 gap-y-3" aria-label="Footer navigation">
      <a
        class="flex min-h-11 items-center text-caption text-inherit decoration-1 underline-offset-5 hover:underline focus-visible:outline-2 focus-visible:outline-offset-5 focus-visible:outline-ink"
        href="/codex-non-specialist-lab">Design lab</a
      ><a
        class="flex min-h-11 items-center text-caption text-inherit decoration-1 underline-offset-5 hover:underline focus-visible:outline-2 focus-visible:outline-offset-5 focus-visible:outline-ink"
        href="#main">Back to top <span aria-hidden="true">↑</span></a
      >
    </nav>
  </footer>
</Layout>
