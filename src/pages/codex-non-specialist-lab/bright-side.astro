      >
        <CapsulePattern
          class="bottom-[-40px] block h-auto pointer-events-none absolute right-[-150px] w-[230px] min-[640px]:bottom-[-50px] min-[640px]:right-[-95px] min-[640px]:w-[280px] min-[900px]:bottom-[-55px] min-[900px]:right-[-90px] min-[900px]:w-[270px]"
        />
      </div>
      <div class="mx-auto max-w-[740px] relative text-center">
        <p
          class="text-[color:var(--accent)] [font-family:var(--sans)] text-[12px] font-semibold tracking-[0.045em] leading-[1.5] m-0 uppercase"
        >
          Let's start with your business
        </p><h2
          class="[font-family:var(--sans)] [font-size:clamp(34px,_4.5vw,_55px)] font-black tracking-[-0.055em] leading-[1.13] m-0 mt-[20px] text-balance"
          id="contact-heading"
        >
          Tell me what your<br /><em
            class="text-[color:var(--accent)] not-italic [font-weight:inherit]"
            >website needs to do.</em
          >
        </h2>
        <p class="text-[color:var(--muted)] text-[15px] [margin:24px_auto_0] max-w-[465px]">
          Send your current website, if you have one, and a little about what you'd like to improve.
          We'll start there.
        </p>
        <div
          class="items-center flex flex-col gap-[15px] mt-[28px] min-[900px]:flex-row min-[900px]:gap-[25px] min-[900px]:justify-center"
        >
          <a
            class="items-center bg-[var(--brand-primary)] [border:1px_solid_var(--brand-primary)] rounded-[7px] text-[color:var(--on-light)] inline-flex text-[13px] font-medium gap-[22px] justify-between leading-[1.4] min-h-[54px] [padding:15px_19px] no-underline [text-decoration-thickness:1px] [text-underline-offset:5px] focus-visible:[box-shadow:0_0_0_3px_var(--paper)] focus-visible:[outline:2px_solid_var(--ink)] focus-visible:[outline-offset:5px] hover:bg-[var(--accent-hover)] hover:[border-color:var(--accent-hover)] hover:no-underline"
            href={email}
            >Talk through your website <span class="text-[20px] font-normal" aria-hidden="true"
              >↗</span
            ></a
          >
        </div>
      </div>
    </section>
  </main>
  <footer
    class="items-center flex flex-wrap [gap:28px_45px] mx-auto py-[34px] [width:min(100%_-_44px,_1180px)] min-[640px]:[width:min(100%_-_80px,_1180px)]"
  >
    <Brand href="/codex-non-specialist-lab/bright-side" /><p
