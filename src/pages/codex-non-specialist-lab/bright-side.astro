    <nav class="flex flex-wrap [gap:12px_26px]" aria-label="Footer navigation">
      <a
        class="items-center text-inherit flex text-[11px] min-h-[44px] [text-decoration-thickness:1px] [text-underline-offset:5px] focus-visible:[box-shadow:0_0_0_3px_var(--paper)] focus-visible:[outline:2px_solid_var(--ink)] focus-visible:[outline-offset:5px] hover:underline"
        href="/codex-non-specialist-lab">Design lab</a
      ><a
        class="items-center text-inherit flex text-[11px] min-h-[44px] [text-decoration-thickness:1px] [text-underline-offset:5px] focus-visible:[box-shadow:0_0_0_3px_var(--paper)] focus-visible:[outline:2px_solid_var(--ink)] focus-visible:[outline-offset:5px] hover:underline"
        href="#main">Back to top <span aria-hidden="true">↑</span></a
