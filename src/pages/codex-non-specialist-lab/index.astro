---
import Layout from '@/layouts/NonSpecialistLabLayout.astro';
import Brand from '@/components/non-specialist-lab/Brand.astro';
import ThemeToggle from '@/components/non-specialist-lab/ThemeToggle.astro';
const palette = ['bg-paper', 'bg-primary', 'bg-mint-soft', 'bg-secondary', 'bg-tertiary'];
---

<Layout
  title="Bright Side | Outfox Web design lab"
  description="The selected Bright Side homepage direction for Outfox Web: inset mint panels, cutout devices, and playful diagonal capsules."
>
  <header
    class="mx-auto flex max-w-315 flex-wrap items-center justify-between gap-5 border-b border-border px-5.5 py-7 sm:px-10"
  >
    <Brand />
    <div class="ml-auto flex flex-wrap items-center justify-end gap-5">
      <span
        class="max-w-35 text-right text-2xs leading-normal font-semibold tracking-widest text-muted-foreground uppercase"
        >An independent design study</span
      >
      <ThemeToggle />
    </div>
  </header>
  <main
    id="main"
    class="mx-auto max-w-315 px-5.5 pt-15 pb-17.5 focus:outline-none sm:px-10"
    tabindex="-1"
  >
    <p
      class="text-caption leading-normal font-semibold tracking-widest text-primary uppercase sm:text-xs"
    >
      Outfox Web / Design lab
    </p>
    <h1 class="mt-5.5 font-editorial text-editorial font-normal text-balance">
      Thoughtful work.<br /><em class="font-normal text-primary">A brighter direction.</em>
    </h1>
    <p class="mt-6.5 max-w-160 text-lg text-muted-foreground">
      Bright Side brings a playful visual voice to expert judgment, considered websites, and the
      person responsible for the work.
    </p>
    <section aria-label="Selected design direction">
      <article
        class="mt-11 grid gap-5 border-t border-border py-7.5 sm:grid-cols-[50px_1fr] sm:gap-6.5 md:grid-cols-[50px_1fr_230px] md:gap-7.5"
      >
        <span class="font-editorial text-service leading-none text-primary" aria-hidden="true"
          >07</span
        >
        <div>
          <p
            class="text-caption leading-normal font-semibold tracking-widest text-muted-foreground uppercase sm:text-xs"
          >
            The friendly expert, with a playful streak
          </p><h2
            class="mt-2.5 font-editorial text-[40px] leading-editorial font-normal tracking-card text-balance"
          >
            Bright Side
          </h2>
          <p class="mt-3.5 max-w-145 text-sm text-muted-foreground">
            Inset mint panels, device cutouts crossing their edges, diagonal capsules, and organic
            image windows. The chosen direction, with the light background and original green
            accents.
          </p>
        </div>
        <div class="sm:col-start-2 md:col-start-3">
          <div
            class="flex gap-1.5"
            role="img"
            aria-label="Light paper, primary mint, soft green, small blue and purple accents"
          >
            {palette.map((color) => <span class:list={['size-7.5 border border-border', color]} />)}
          </div>
          <p class="mt-2.5 text-xs text-muted-foreground">Manrope + diagonal capsules</p>
          <a
            class="mt-5 inline-flex min-h-13 items-center justify-between gap-7 border border-primary bg-primary px-5 py-3.5 text-label leading-label font-medium text-primary-foreground no-underline hover:border-primary-hover hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-5 focus-visible:outline-ring"
            href="/codex-non-specialist-lab/bright-side"
            >View Bright Side <span class="text-xl font-normal" aria-hidden="true">↗</span></a
          >
          <p class="mt-2.5 text-xs text-muted-foreground">Selected direction · restored</p>
        </div>
      </article>
    </section>
  </main>
  <footer
    class="mx-auto flex max-w-315 flex-wrap justify-between gap-3 border-t border-border px-5.5 pt-5 pb-7.5 text-caption sm:px-10"
  >
    <span>Outfox Web / Design exploration</span><span>Bright Side</span>
  </footer>
</Layout>
